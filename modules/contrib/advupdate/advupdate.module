<?php

/**
 * @file
 * Contains advupdate.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\advupdate\Hook\AdvupdateHooks;
use Drupal\Component\Render\MarkupInterface;
use Drupal\advupdate\Render\UpdateDetailsMarkup;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function advupdate_help($route_name, RouteMatchInterface $route_match): string {
  return \Drupal::service(AdvupdateHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
#[LegacyHook]
function advupdate_form_update_settings_alter(&$form, FormStateInterface $form_state, $form_id): void {
  \Drupal::service(AdvupdateHooks::class)->formUpdateSettingsAlter($form, $form_state, $form_id);
}

/**
 * Save "notification.extend_email_report" to the configuration.
 */
function advupdate_form_update_settings_submit_handler($form, FormStateInterface $form_state): void {
  \Drupal::configFactory()->getEditable('advupdate.settings')
    ->set('notification.extend_email_report', $form_state->getValue('update_notification_extend_email_report'))
    ->save();
}

/**
 * Implements hook_mail_alter().
 */
#[LegacyHook]
function advupdate_mail_alter(&$message): void {
  \Drupal::service(AdvupdateHooks::class)->mailAlter($message);
}

/**
 * Render a list for available updating of core/modules/themes.
 *
 * @return \Drupal\Component\Render\MarkupInterface|false
 */
function _advupdate_mail_additional_data(): MarkupInterface|false {
  \Drupal::moduleHandler()->loadInclude('update', 'module');
  \Drupal::moduleHandler()->loadInclude('update', 'inc', 'update.compare');

  $available = update_get_available(FALSE);
  if (empty($available)) {
    return FALSE;
  }

  $project_data = update_calculate_project_data($available);
  return UpdateDetailsMarkup::createFromProjectData($project_data);
}
