<?php

/**
 * @file
 * Uses the dialogClass dialog option in different ways.
 */

/**
 * Returns dialog options.
 */
function upgrade_status_test_dialog_options(array $options): array {
  // The dialogClass option in a comment is not reported: 'dialogClass'.
  $dialogClass = 'not-an-option';
  $json = '{"width":800,"dialogClass":"test-dialog"}';
  unset($options['dialogClass']);
  return [
    'dialogClass' => $dialogClass,
    'json' => $json,
    'classes' => ['ui-dialog' => 'test-dialog'],
    'description' => 'This text mentions dialogClass but does not use it.',
  ];
}

/**
 * Returns an autocomplete field with the old attribute.
 */
function upgrade_status_test_dialog_autocomplete(): array {
  // cspell:ignore blacklist
  // Not reported: data-autocomplete-first-character-blacklist.
  return [
    '#type' => 'textfield',
    '#attributes' => ['data-autocomplete-first-character-blacklist' => '$'],
  ];
}
