<?php

/**
 * @file
 * Uses deprecated routes for upgrade status module testing.
 */

use Drupal\Core\Url;

/**
 * Builds URLs of deprecated and current routes.
 */
function upgrade_status_test_routes_urls(): array {
  return [
    Url::fromRoute('upgrade_status_test_routes_provider.old'),
    Url::fromRoute("upgrade_status_test_routes_provider.alias"),
    Url::fromRoute('upgrade_status_test_routes_provider.new'),
    // Longer names are not reported.
    Url::fromRoute('upgrade_status_test_routes_provider.old.edit'),
  ];
}
