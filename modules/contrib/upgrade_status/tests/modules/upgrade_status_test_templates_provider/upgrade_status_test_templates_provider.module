<?php

/**
 * @file
 * Provides deprecated templates for upgrade status module testing.
 */

use Drupal\upgrade_status_test_templates_provider\Preprocess;

/**
 * Implements hook_theme().
 */
function upgrade_status_test_templates_provider_theme(): array {
  return [
    'upgrade_status_test_deprecated' => [
      'variables' => ['items' => []],
      'deprecated' => 'The "upgrade-status-test-deprecated" template is deprecated in drupal:11.0.0 and is removed from drupal:12.0.0. Use "item_list" instead. See https://www.drupal.org/node/3157353',
    ],
    'upgrade_status_test_variables' => [
      'variables' => [
        'old' => NULL,
        'new' => NULL,
        'deprecations' => [
          'old' => "'old' is deprecated in drupal:11.0.0 and is removed from drupal:12.0.0. Use 'new' instead. See https://www.drupal.org/node/3157353",
        ],
      ],
      'initial preprocess' => Preprocess::class . ':preprocessVariables',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for upgrade_status_test_variables.
 */
function upgrade_status_test_templates_provider_preprocess_upgrade_status_test_variables(array &$variables): void {
  $variables['deprecations']['oldest'] = "'oldest' is deprecated in drupal:11.0.0 and is removed in drupal:12.0.0. Use 'new' instead. See https://www.drupal.org/node/3157353";
  $variables['oldest'] = $variables['old'];
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for upgrade_status_test_variables.
 */
function upgrade_status_test_templates_provider_theme_suggestions_upgrade_status_test_variables_alter(array &$suggestions, array $variables): void {
  $suggestions[] = 'upgrade_status_test_variables__old';
  $suggestions['__DEPRECATED']['upgrade_status_test_variables__old'] = 'Theme suggestion upgrade_status_test_variables__old is deprecated in drupal:11.0.0 and is removed from drupal:12.0.0. Use upgrade_status_test_variables__new instead. See https://www.drupal.org/node/3157353';
  $suggestions[] = 'upgrade_status_test_variables__legacy__' . $variables['new'];
  $suggestions['__DEPRECATED']['upgrade_status_test_variables__legacy__' . $variables['new']] = 'Theme suggestion upgrade_status_test_variables__legacy__' . $variables['new'] . ' is deprecated in drupal:11.0.0 and is removed from drupal:13.0.0. See https://www.drupal.org/node/3157353';
}
