# macOS
.DS_Store

# Local AI agent state (personal; never committed — see AGENTS.md "Agent permissions")
.claude/
.codex

# Python
__pycache__/
*.pyc
.venv/
venv/
# build metadata from the editable install (evals/inspect/ registers abp_cli)
*.egg-info/
build/
dist/

# Local installation file
composer.lock
.idea/
.phpunit.cache/
.php-cs-fixer.cache
vendor/

# Disposable Composer smoke projects (local path-repo tests)
tests/smoke-workspaces/

# Ephemeral behavioral trace output (run-evals.py --output-dir ./traces).
# Root-anchored so the committed parity-fixture traces under
# evals/<skill>/traces/ (re-graded by the scorer drift guard) are NOT ignored.
/traces/

# Generated Agent Skills catalog (scripts/build-agent-skills-index.py)
/pages/.well-known/

# Files generated by behavioral evals writing to disk
**/tests/playwright/
**/tests/src/Functional/
playwright.config.js